<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <?ifdef JpIsSystemWide ?>
    <?define JpInstallScope="perMachine"?>
  <?else?>
    <?define JpInstallScope="perUser"?>
  <?endif?>

  <?define JpProductLanguage=1033 ?>
  <?define JpInstallerVersion=200 ?>
  <?define JpCompressedMsi=yes ?>

  <?ifdef JpAllowUpgrades ?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="no"?>
  <?else?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="yes"?>
  <?endif?>
  <?ifdef JpAllowDowngrades ?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="no"?>
  <?else?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="yes"?>
  <?endif?>

  <?include $(var.JpConfigDir)/overrides.wxi ?>

  <Product
    Id="$(var.JpProductCode)"
    Name="$(var.JpAppName)"
    Language="$(var.JpProductLanguage)"
    Version="$(var.JpAppVersion)"
    Manufacturer="$(var.JpAppVendor)"
    UpgradeCode="$(var.JpProductUpgradeCode)">

    <Package
      Description="$(var.JpAppDescription)"
      Manufacturer="$(var.JpAppVendor)"
      InstallerVersion="$(var.JpInstallerVersion)"
      Compressed="$(var.JpCompressedMsi)"
      InstallScope="$(var.JpInstallScope)" Platform="x64"
    />

    <Media Id="1" Cabinet="Data.cab" EmbedCab="yes" />

    <!-- Prevent Restart Manager from deferring locked GATES runtime files to post-reboot deletion. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />

    <Upgrade Id="$(var.JpProductUpgradeCode)">
      <UpgradeVersion
        OnlyDetect="$(var.JpUpgradeVersionOnlyDetectUpgrade)"
        Property="JP_UPGRADABLE_FOUND"
        Maximum="$(var.JpAppVersion)"
        MigrateFeatures="yes"
        IncludeMaximum="$(var.JpUpgradeVersionOnlyDetectUpgrade)" />
      <UpgradeVersion
        OnlyDetect="$(var.JpUpgradeVersionOnlyDetectDowngrade)"
        Property="JP_DOWNGRADABLE_FOUND"
        Minimum="$(var.JpAppVersion)"
        MigrateFeatures="yes"
        IncludeMinimum="$(var.JpUpgradeVersionOnlyDetectDowngrade)" />
    </Upgrade>

    <?ifndef JpAllowUpgrades ?>
    <CustomAction Id="JpDisallowUpgrade" Error="!(loc.DisallowUpgradeErrorMessage)" />
    <?endif?>
    <?ifndef JpAllowDowngrades ?>
    <CustomAction Id="JpDisallowDowngrade" Error="!(loc.DowngradeErrorMessage)" />
    <?endif?>

    <!-- Standard required root -->
    <Directory Id="TARGETDIR" Name="SourceDir"/>

    <Feature Id="DefaultFeature" Title="!(loc.MainFeatureTitle)" Level="1">
      <ComponentGroupRef Id="Shortcuts"/>
      <ComponentGroupRef Id="Files"/>
      <ComponentGroupRef Id="FileAssociations"/>
    </Feature>

    <CustomAction Id="JpSetARPINSTALLLOCATION" Property="ARPINSTALLLOCATION" Value="[INSTALLDIR]" />
    <CustomAction Id="JpSetARPCOMMENTS" Property="ARPCOMMENTS" Value="$(var.JpAppDescription)" />
    <CustomAction Id="JpSetARPCONTACT" Property="ARPCONTACT" Value="$(var.JpAppVendor)" />
    <CustomAction Id="JpSetARPSIZE" Property="ARPSIZE" Value="$(var.JpAppSizeKb)" />

    <?ifdef JpHelpURL ?>
      <CustomAction Id="JpSetARPHELPLINK" Property="ARPHELPLINK" Value="$(var.JpHelpURL)" />
    <?endif?>

    <?ifdef JpAboutURL ?>
      <CustomAction Id="JpSetARPURLINFOABOUT" Property="ARPURLINFOABOUT" Value="$(var.JpAboutURL)" />
    <?endif?>

    <?ifdef JpUpdateURL ?>
      <CustomAction Id="JpSetARPURLUPDATEINFO" Property="ARPURLUPDATEINFO" Value="$(var.JpUpdateURL)" />
    <?endif?>

    <!-- Close user-session tray/UI GATES.exe before InstallValidate without touching the SYSTEM service. -->
    <CustomAction
      Id="SetCloseGatesTrayUi"
      Property="CloseGatesTrayUi"
      Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -Command &quot;Get-CimInstance Win32_Process -Filter 'Name=''GATES.exe''' -ErrorAction SilentlyContinue | Where-Object { $_.CommandLine -and $_.CommandLine -notmatch '--runtime-service' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }&quot;" />
    <CustomAction
      Id="CloseGatesTrayUi"
      BinaryKey="WixCA"
      DllEntry="WixQuietExec64"
      Execute="immediate"
      Return="ignore" />

    <!-- Elevated stop of GatesVpn failure-restart + service + residual runtime binaries before InstallFiles and RemoveExistingProducts. -->
    <CustomAction
      Id="SetStopGatesRuntime"
      Property="StopGatesRuntime"
      Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -Command &quot;if (Get-Service -Name GatesVpn -ErrorAction SilentlyContinue) { Start-Process -FilePath sc.exe -ArgumentList ('failure GatesVpn reset= 0 actions= ' + [char]34 + [char]34) -WindowStyle Hidden -Wait -ErrorAction SilentlyContinue; Start-Process -FilePath sc.exe -ArgumentList 'stop GatesVpn' -WindowStyle Hidden -Wait -ErrorAction SilentlyContinue; try { (Get-Service -Name GatesVpn).WaitForStatus('Stopped', [TimeSpan]::FromSeconds(20)) } catch {} }; taskkill.exe /F /T /IM Gates.Service.exe 2&gt;$null | Out-Null; taskkill.exe /F /IM GATES.exe 2&gt;$null | Out-Null; $r = '[INSTALLDIR]'; Get-Process xray,sing-box -ErrorAction SilentlyContinue | Where-Object { $_.Path -and $_.Path.StartsWith($r, [System.StringComparison]::OrdinalIgnoreCase) } | Stop-Process -Force -ErrorAction SilentlyContinue; Start-Sleep -Milliseconds 500&quot;" />
    <CustomAction
      Id="StopGatesRuntime"
      BinaryKey="WixCA"
      DllEntry="WixQuietExec64"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <!-- Restore GatesVpn failure-restart and start the service cleanly after all files and upgrades complete. -->
    <CustomAction
      Id="SetStartGatesRuntime"
      Property="StartGatesRuntime"
      Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -Command &quot;if (Get-Service -Name GatesVpn -ErrorAction SilentlyContinue) { Start-Process -FilePath sc.exe -ArgumentList 'failure GatesVpn reset= 3600 actions= restart/10000' -WindowStyle Hidden -Wait -ErrorAction SilentlyContinue; Start-Process -FilePath sc.exe -ArgumentList 'start GatesVpn' -WindowStyle Hidden -Wait -ErrorAction SilentlyContinue }&quot;" />
    <CustomAction
      Id="StartGatesRuntime"
      BinaryKey="WixCA"
      DllEntry="WixQuietExec64"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <?ifdef JpIcon ?>
    <Property Id="ARPPRODUCTICON" Value="JpARPPRODUCTICON"/>
    <Icon Id="JpARPPRODUCTICON" SourceFile="$(var.JpIcon)"/>
    <?endif?>

    <UIRef Id="JpUI"/>

    <InstallExecuteSequence>
      <Custom Action="JpSetARPINSTALLLOCATION" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPCOMMENTS" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPCONTACT" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPSIZE" After="CostFinalize">Not Installed</Custom>
      <?ifdef JpHelpURL ?>
        <Custom Action="JpSetARPHELPLINK" After="CostFinalize">Not Installed</Custom>
      <?endif?>
      <?ifdef JpAboutURL ?>
        <Custom Action="JpSetARPURLINFOABOUT" After="CostFinalize">Not Installed</Custom>
      <?endif?>
      <?ifdef JpUpdateURL ?>
        <Custom Action="JpSetARPURLUPDATEINFO" After="CostFinalize">Not Installed</Custom>
      <?endif?>

      <?ifndef JpAllowUpgrades ?>
      <Custom Action="JpDisallowUpgrade" After="FindRelatedProducts">JP_UPGRADABLE_FOUND</Custom>
      <?endif?>
      <?ifndef JpAllowDowngrades ?>
      <Custom Action="JpDisallowDowngrade" After="FindRelatedProducts">JP_DOWNGRADABLE_FOUND</Custom>
      <?endif?>

      <Custom Action="SetCloseGatesTrayUi" Before="CloseGatesTrayUi" />
      <Custom Action="CloseGatesTrayUi" Before="InstallValidate" />
      <Custom Action="SetStopGatesRuntime" After="InstallInitialize" />
      <Custom Action="StopGatesRuntime" After="SetStopGatesRuntime" />
      <InstallExecute After="PublishProduct" />
      <RemoveExistingProducts After="InstallExecute" />
      <Custom Action="SetStartGatesRuntime" After="RemoveExistingProducts">NOT (REMOVE=&quot;ALL&quot;)</Custom>
      <Custom Action="StartGatesRuntime" After="SetStartGatesRuntime">NOT (REMOVE=&quot;ALL&quot;)</Custom>
    </InstallExecuteSequence>

  </Product>
</Wix>
