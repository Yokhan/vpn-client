#!/bin/sh

remote_name="$1"
remote_url="$2"
repo="Yokhan/YokhanVPN"
workflow="preview.yml"
branch=""
local_sha=""

[ "$remote_name" = "origin" ] || exit 0
command -v gh >/dev/null 2>&1 || exit 0

while read local_ref local_oid remote_ref remote_oid
do
  case "$remote_ref" in
    refs/heads/*)
      branch=${remote_ref#refs/heads/}
      local_sha="$local_oid"
      break
      ;;
  esac
done

[ -n "$branch" ] || exit 0
[ -n "$local_sha" ] || exit 0

(
  attempt=0
  while [ "$attempt" -lt 30 ]
  do
    remote_sha=$(git ls-remote "$remote_url" "refs/heads/$branch" 2>/dev/null | awk 'NR==1 { print $1 }')
    if [ "$remote_sha" = "$local_sha" ]; then
      gh workflow run "$workflow" -R "$repo" --ref "$branch" >/dev/null 2>&1
      exit 0
    fi
    attempt=$((attempt + 1))
    sleep 2
  done
  exit 0
) >/dev/null 2>&1 &

exit 0
