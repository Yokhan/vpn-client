<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/dashboard_bg_off">

    <View
        android:id="@+id/dashboard_space_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/dashboard_space_bg" />

    <View
        android:id="@+id/dashboard_space_glow"
        android:layout_width="@dimen/dashboard_space_glow_width"
        android:layout_height="@dimen/dashboard_space_glow_height"
        android:layout_gravity="bottom|center_horizontal"
        android:alpha="0"
        android:background="@drawable/bg_dashboard_space_glow"
        android:translationY="@dimen/dashboard_space_glow_bottom_offset" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dashboard_toolbar_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:minHeight="?attr/actionBarSize"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:theme="?actionBarTheme"
                app:contentInsetStartWithNavigation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/toolbar_status"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:title="@string/app_name"
                app:titleTextColor="@color/dashboard_text_primary" />

            <LinearLayout
                android:id="@+id/toolbar_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                app:layout_constraintBottom_toBottomOf="@id/toolbar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/toolbar">

                <TextView
                    android:id="@+id/toolbar_sys_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:letterSpacing="0.02"
                    android:textColor="@color/dashboard_text_secondary"
                    android:textSize="12sp"
                    tools:text="VPN" />

                <View
                    android:id="@+id/toolbar_sys_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_profile_dot" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="104dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/current_config_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/dashboard_card_border_off"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <LinearLayout
                            android:id="@+id/current_config_tag_row"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            app:layout_constraintEnd_toStartOf="@+id/signal_box"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginEnd="4dp"
                                android:background="@drawable/bg_dashboard_tag_square" />

                            <TextView
                                android:id="@+id/current_config_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/jetbrains_mono"
                                android:letterSpacing="0.06"
                                android:text="@string/dashboard_current_config"
                                android:textAllCaps="true"
                                android:textColor="@color/dashboard_text_tertiary"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/current_profile_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/golos_text"
                            android:maxLines="1"
                            android:textColor="@color/dashboard_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/signal_box"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/current_config_tag_row"
                            tools:text="Bridge-igor" />

                        <TextView
                            android:id="@+id/current_profile_info"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/jetbrains_mono"
                            android:maxLines="1"
                            android:textColor="@color/dashboard_text_secondary"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toStartOf="@+id/signal_box"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/current_profile_name"
                            tools:text="VLESS · Подписка #1776115554141" />

                        <FrameLayout
                            android:id="@+id/signal_box"
                            android:layout_width="@dimen/dashboard_signal_box_size"
                            android:layout_height="@dimen/dashboard_signal_box_size"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_dashboard_signal_box_off"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:id="@+id/signal_bars"
                                android:layout_width="@dimen/dashboard_signal_bars_width"
                                android:layout_height="@dimen/dashboard_signal_bars_height"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_dashboard_signal_bars"
                                android:tint="@color/dashboard_text_primary" />

                            <View
                                android:id="@+id/signal_status_dot"
                                android:layout_width="5dp"
                                android:layout_height="5dp"
                                android:layout_gravity="top|end"
                                android:layout_marginTop="5dp"
                                android:layout_marginEnd="5dp"
                                android:background="@drawable/bg_profile_dot" />
                        </FrameLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/connect_zone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="18dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="18dp">

                    <LinearLayout
                        android:id="@+id/upload_container"
                        android:layout_width="@dimen/dashboard_speed_panel_width"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="@id/connect_circle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/connect_circle">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jetbrains_mono"
                            android:letterSpacing="0.08"
                            android:text="@string/dashboard_upload_label"
                            android:textColor="@color/dashboard_text_tertiary"
                            android:textSize="10sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/upload_speed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/jetbrains_mono"
                                android:textColor="@color/dashboard_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="0 B/s" />

                            <TextView
                                android:id="@+id/upload_arrow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:fontFamily="@font/jetbrains_mono"
                                android:text="↑"
                                android:textColor="@color/dashboard_accent"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/upload_wave"
                            android:layout_width="@dimen/dashboard_wave_width"
                            android:layout_height="@dimen/dashboard_wave_height"
                            android:layout_marginTop="4dp"
                            android:alpha="0.25"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_dashboard_wave"
                            android:tint="@color/dashboard_accent" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/connect_circle"
                        android:layout_width="@dimen/dashboard_orb_size"
                        android:layout_height="@dimen/dashboard_orb_size"
                        android:clickable="true"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        app:layout_constraintEnd_toStartOf="@id/download_container"
                        app:layout_constraintStart_toEndOf="@id/upload_container"
                        app:layout_constraintTop_toTopOf="parent">

                        <View
                            android:id="@+id/orb_background"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_dashboard_orb_off" />

                        <io.nekohasekai.sagernet.widget.OrbMarksView
                            android:id="@+id/orb_marks"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no" />

                        <View
                            android:id="@+id/connect_ring"
                            android:layout_width="@dimen/dashboard_orb_ring_size"
                            android:layout_height="@dimen/dashboard_orb_ring_size"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_dashboard_orb_ring_off" />

                        <TextView
                            android:id="@+id/connect_center_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/jetbrains_mono"
                            android:letterSpacing="0.12"
                            android:text="@string/dashboard_orb_idle"
                            android:textColor="@color/dashboard_text_secondary"
                            android:textSize="12sp" />

                        <FrameLayout
                            android:id="@+id/rocket_group"
                            android:layout_width="@dimen/dashboard_rocket_scene_width"
                            android:layout_height="@dimen/dashboard_rocket_scene_height"
                            android:layout_gravity="center"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:alpha="0">

                            <ImageView
                                android:id="@+id/rocket_flame_left"
                                android:layout_width="@dimen/dashboard_rocket_flame_width"
                                android:layout_height="@dimen/dashboard_rocket_flame_height"
                                android:layout_gravity="bottom|center_horizontal"
                                android:layout_marginBottom="@dimen/dashboard_rocket_flame_bottom"
                                android:alpha="0"
                                android:contentDescription="@null"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_dashboard_spaceship_flame"
                                android:translationX="@dimen/dashboard_rocket_flame_left_offset" />

                            <ImageView
                                android:id="@+id/rocket_flame_right"
                                android:layout_width="@dimen/dashboard_rocket_flame_width"
                                android:layout_height="@dimen/dashboard_rocket_flame_height"
                                android:layout_gravity="bottom|center_horizontal"
                                android:layout_marginBottom="@dimen/dashboard_rocket_flame_bottom"
                                android:alpha="0"
                                android:contentDescription="@null"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_dashboard_spaceship_flame"
                                android:translationX="@dimen/dashboard_rocket_flame_right_offset" />

                            <ImageView
                                android:id="@+id/connect_icon"
                                android:layout_width="@dimen/dashboard_rocket_width"
                                android:layout_height="@dimen/dashboard_rocket_height"
                                android:layout_gravity="top|center_horizontal"
                                android:contentDescription="@string/dashboard_connect_action"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_dashboard_spaceship"
                                android:translationY="@dimen/dashboard_rocket_y_offset" />
                        </FrameLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/download_container"
                        android:layout_width="@dimen/dashboard_speed_panel_width"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="@id/connect_circle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/connect_circle">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jetbrains_mono"
                            android:letterSpacing="0.08"
                            android:text="@string/dashboard_download_label"
                            android:textColor="@color/dashboard_text_tertiary"
                            android:textSize="10sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/download_speed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/jetbrains_mono"
                                android:textColor="@color/dashboard_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="0 B/s" />

                            <TextView
                                android:id="@+id/download_arrow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:fontFamily="@font/jetbrains_mono"
                                android:text="↓"
                                android:textColor="@color/dashboard_accent"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/download_wave"
                            android:layout_width="@dimen/dashboard_wave_width"
                            android:layout_height="@dimen/dashboard_wave_height"
                            android:layout_marginTop="4dp"
                            android:alpha="0.25"
                            android:contentDescription="@null"
                            android:scaleX="-1"
                            android:src="@drawable/ic_dashboard_wave"
                            android:tint="@color/dashboard_accent" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/connect_status_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/connect_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono"
                        android:gravity="center"
                        android:letterSpacing="0.02"
                        android:text="@string/dashboard_tap_connect"
                        android:textColor="@color/dashboard_text_tertiary"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/connection_timer"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="Нажмите для подключения" />

                    <TextView
                        android:id="@+id/connection_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono"
                        android:letterSpacing="0.04"
                        android:textColor="@color/dashboard_text_tertiary"
                        android:textSize="12sp"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="00:01:24"
                        tools:visibility="visible" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/test_connection_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_dashboard_test_button_off"
                    android:clickable="true"
                    android:drawablePadding="8dp"
                    android:focusable="true"
                    android:fontFamily="@font/golos_text"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:text="@string/dashboard_check_connection"
                    android:textAllCaps="true"
                    android:textColor="@color/dashboard_text_secondary"
                    android:textSize="10sp"
                    android:drawableStart="@drawable/ic_baseline_shutter_speed_24"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/profiles_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/dashboard_card_border_off"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="6dp"
                                    android:layout_height="6dp"
                                    android:layout_marginEnd="4dp"
                                    android:background="@drawable/bg_dashboard_tag_square" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/jetbrains_mono"
                                    android:letterSpacing="0.06"
                                    android:text="@string/dashboard_configurations"
                                    android:textAllCaps="true"
                                    android:textColor="@color/dashboard_text_secondary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/add_config"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/jetbrains_mono"
                                android:text="@string/dashboard_add"
                                android:textColor="@color/dashboard_accent"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/profiles_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <io.nekohasekai.sagernet.widget.StarfieldView
        android:id="@+id/dashboard_stars"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
