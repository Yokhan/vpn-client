<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_bg_off"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/debug_crash"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Crash From Kt"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/dashboard_accent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/reset_settings"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reset Settings"
        android:textColor="@color/dashboard_text_primary"
        app:strokeColor="@color/dashboard_card_border_off" />

</LinearLayout>
