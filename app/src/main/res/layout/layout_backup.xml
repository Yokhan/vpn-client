<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_bg_off"
    android:orientation="vertical"
    android:padding="12dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/reset_settings"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reset_settings"
        android:textColor="@color/dashboard_text_primary"
        app:strokeColor="@color/dashboard_card_border_off" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/backup_configurations"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:fontFamily="@font/golos_text"
        android:text="@string/backup_groups_and_configurations"
        android:textColor="@color/dashboard_text_primary" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/backup_rules"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:fontFamily="@font/golos_text"
        android:text="@string/backup_rules"
        android:textColor="@color/dashboard_text_primary" />


    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/backup_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:fontFamily="@font/golos_text"
        android:text="@string/backup_settings"
        android:textColor="@color/dashboard_text_primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action_export"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/action_export"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/dashboard_accent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action_share"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/share"
        android:textColor="@color/dashboard_text_primary"
        app:strokeColor="@color/dashboard_card_border_off" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/golos_text"
        android:text="@string/backup_summary"
        android:textColor="@color/dashboard_text_secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action_import_file"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/action_import_file"
        android:textColor="@color/dashboard_text_primary"
        app:strokeColor="@color/dashboard_card_border_off" />


</LinearLayout>
