<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_bg_off"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/backup_configurations"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:fontFamily="@font/golos_text"
        android:text="@string/backup_groups_and_configurations"
        android:textColor="@color/dashboard_text_primary"
        app:buttonTint="@color/dashboard_accent" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/backup_rules"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:fontFamily="@font/golos_text"
        android:text="@string/backup_rules"
        android:textColor="@color/dashboard_text_primary"
        app:buttonTint="@color/dashboard_accent" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/backup_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:fontFamily="@font/golos_text"
        android:text="@string/backup_settings"
        android:textColor="@color/dashboard_text_primary"
        app:buttonTint="@color/dashboard_accent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/golos_text"
        android:text="@string/backup_import_summary"
        android:textColor="@color/dashboard_accent">

    </TextView>

</LinearLayout>
