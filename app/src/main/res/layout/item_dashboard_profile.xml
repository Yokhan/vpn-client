<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/profile_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/dashboard_divider_light" />

    <LinearLayout
        android:id="@+id/profile_item_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="42dp"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <View
            android:id="@+id/profile_active_bar"
            android:layout_width="2dp"
            android:layout_height="42dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_dashboard_profile_active_bar"
            tools:backgroundTint="@color/dashboard_accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/jetbrains_mono"
                android:maxLines="1"
                android:textColor="@color/dashboard_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Bridge-igor" />

            <TextView
                android:id="@+id/profile_protocol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/jetbrains_mono"
                android:letterSpacing="0.02"
                android:textColor="@color/dashboard_text_tertiary"
                android:textSize="12sp"
                tools:text="VLESS" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/profile_edit"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/edit"
                android:padding="4dp"
                android:src="@drawable/ic_image_edit"
                android:tint="@color/dashboard_text_quaternary" />

            <ImageButton
                android:id="@+id/profile_menu"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="4dp"
                android:src="@drawable/ic_baseline_more_vert_24"
                android:tint="@color/dashboard_text_quaternary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
