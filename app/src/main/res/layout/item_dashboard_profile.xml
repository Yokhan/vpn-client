<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Active indicator bar (colored for active, transparent for inactive) -->
    <View
        android:id="@+id/profile_active_bar"
        android:layout_width="@dimen/profile_bar_width"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:background="@color/buffit_orange"
        tools:background="@color/buffit_orange" />

    <!-- Status dot -->
    <View
        android:id="@+id/profile_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_profile_dot"
        tools:ignore="ContentDescription" />

    <!-- Profile info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/profile_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textStyle="bold"
            tools:text="Bridge-igor" />

        <TextView
            android:id="@+id/profile_protocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?android:textColorSecondary"
            tools:text="VLESS" />
    </LinearLayout>

    <!-- Edit button -->
    <ImageButton
        android:id="@+id/profile_edit"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/edit"
        android:src="@drawable/ic_image_edit"
        android:tint="?android:textColorSecondary" />

    <!-- Menu button -->
    <ImageButton
        android:id="@+id/profile_menu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@null"
        android:src="@drawable/ic_baseline_more_vert_24"
        android:tint="?android:textColorSecondary" />

</LinearLayout>
