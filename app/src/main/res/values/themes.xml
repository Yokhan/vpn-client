<resources>
    <!-- Base application theme. -->
    <style name="Theme.SagerNet" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="actionBarStyle">@style/Widget.MaterialComponents.ActionBar.Solid</item>
        <item name="actionModeCloseDrawable">@drawable/ic_navigation_close</item>
        <item name="colorButtonNormal">?colorAccent</item>
        <item name="android:navigationBarColor">@color/dashboard_bg_off</item>
        <!-- YokhanVPN Design System tokens -->
        <item name="android:colorBackground">@color/dashboard_bg_off</item>
        <item name="android:windowBackground">@color/dashboard_bg_off</item>
        <item name="colorSurface">@color/dashboard_bg_off</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorPrimary">@color/dashboard_text_primary</item>
        <item name="colorPrimaryDark">@color/dashboard_bg_off</item>
        <item name="colorAccent">@color/dashboard_accent</item>

        <item name="colorMaterial100">@color/dashboard_bg_off</item>
        <item name="colorMaterial300">@color/dashboard_divider_light</item>

        <item name="accentOrTextSecondary">?colorAccent</item>
        <item name="accentOrTextPrimary">?colorAccent</item>
        <item name="primaryOrTextSecondary">?colorPrimary</item>
        <item name="primaryOrTextPrimary">?colorPrimary</item>

        <item name="fabColorBackground">@color/dashboard_text_primary</item>
        <item name="selectedColorPrimary">@color/dashboard_text_primary</item>
        <item name="itemShapeFillColor">@color/dashboard_divider_light</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.DayNight.ActionBar</item>
        <item name="tabTextColor">#99000000</item>
        <item name="tabSelectedTextColor">@color/dashboard_text_primary</item>
        <item name="tabIndicatorColor">@color/dashboard_accent</item>
        <item name="tabRippleColor">@color/dashboard_accent</item>
        <item name="whiteOrTextPrimary">@color/dashboard_text_primary</item>

        <item name="windowActionModeOverlay">true</item>

        <!-- Remove ActionBar but keep styles and themes -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="chipStyle">@style/Widget.MaterialComponents.Chip.Choice.SagerNet</item>
        <item name="materialCardViewStyle">@style/Widget.BuffIT.CardView</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.BuffIT.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.BuffIT.Medium</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.BuffIT.Medium</item>

        <!-- Typography: fontFamily only, styles available for explicit use -->
        <item name="android:fontFamily">@font/golos_text</item>
        <item name="fontFamily">@font/golos_text</item>

        <item name="alertDialogTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet
        </item>

        <item name="materialAlertDialogTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet
        </item>

    </style>

    <style name="Theme.SagerNet.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="actionBarStyle">@style/Widget.MaterialComponents.ActionBar.Solid</item>
        <item name="actionModeCloseDrawable">@drawable/ic_navigation_close</item>
        <item name="colorButtonNormal">?colorAccent</item>
        <item name="android:navigationBarColor">@color/dashboard_bg_off</item>
        <!-- YokhanVPN Design System tokens -->
        <item name="android:colorBackground">@color/dashboard_bg_off</item>
        <item name="android:windowBackground">@color/dashboard_bg_off</item>
        <item name="colorSurface">@color/dashboard_bg_off</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorPrimary">@color/dashboard_text_primary</item>
        <item name="colorPrimaryDark">@color/dashboard_bg_off</item>
        <item name="colorAccent">@color/dashboard_accent</item>

        <item name="colorMaterial100">@color/dashboard_bg_off</item>
        <item name="colorMaterial300">@color/dashboard_divider_light</item>

        <item name="accentOrTextSecondary">?colorAccent</item>
        <item name="accentOrTextPrimary">?colorAccent</item>
        <item name="primaryOrTextSecondary">?colorPrimary</item>
        <item name="primaryOrTextPrimary">?colorPrimary</item>

        <item name="fabColorBackground">@color/dashboard_text_primary</item>
        <item name="selectedColorPrimary">@color/dashboard_text_primary</item>
        <item name="itemShapeFillColor">@color/dashboard_divider_light</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.DayNight.ActionBar</item>
        <item name="tabTextColor">#99000000</item>
        <item name="tabSelectedTextColor">@color/dashboard_text_primary</item>
        <item name="tabIndicatorColor">@color/dashboard_accent</item>
        <item name="tabRippleColor">@color/dashboard_accent</item>
        <item name="whiteOrTextPrimary">@color/dashboard_text_primary</item>

        <item name="windowActionModeOverlay">true</item>

        <!-- Remove ActionBar but keep styles and themes -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="chipStyle">@style/Widget.MaterialComponents.Chip.Choice.SagerNet</item>
        <item name="materialCardViewStyle">@style/Widget.BuffIT.CardView</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.BuffIT.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.BuffIT.Medium</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.BuffIT.Medium</item>

        <!-- Typography: fontFamily only -->
        <item name="android:fontFamily">@font/golos_text</item>
        <item name="fontFamily">@font/golos_text</item>

        <item name="alertDialogTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet
        </item>

        <item name="materialAlertDialogTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet
        </item>

        <item name="windowFixedHeightMajor" type="dimen">95%</item>

    </style>

    <style name="AppearanceFoundation.Title" parent="TextAppearance.BuffIT.Headline">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet">
        <item name="buttonBarPositiveButtonStyle">
            @style/Widget.MaterialComponents.Button.TextButton.Dialog.Primary
        </item>
        <item name="buttonBarNegativeButtonStyle">
            @style/Widget.MaterialComponents.Button.TextButton.Dialog.Primary
        </item>
        <item name="buttonBarNeutralButtonStyle">
            @style/Widget.MaterialComponents.Button.TextButton.Dialog.Flush.Primary
        </item>
    </style>

    <style name="Widget.MaterialComponents.Button.TextButton.Dialog.Primary">
        <item name="android:textColor">?primaryOrTextPrimary</item>
    </style>

    <style name="Widget.MaterialComponents.Button.TextButton.Dialog.Flush.Primary">
        <item name="android:textColor">?primaryOrTextPrimary</item>
    </style>

    <style name="Widget.MaterialComponents.Chip.Choice.SagerNet">
        <item name="textStartPadding">30dp</item>
        <item name="textEndPadding">30dp</item>
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="checkedIconTint">?primaryOrTextPrimary</item>
        <item name="rippleColor">@color/chip_ripple_color</item>
    </style>

    <!-- BUFF IT Typography Scale -->
    <style name="TextAppearance.BuffIT.Display" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">@font/unbounded</item>
        <item name="fontFamily">@font/unbounded</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>

    <style name="TextAppearance.BuffIT.Headline" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/unbounded</item>
        <item name="fontFamily">@font/unbounded</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>

    <style name="TextAppearance.BuffIT.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/unbounded</item>
        <item name="fontFamily">@font/unbounded</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>

    <style name="TextAppearance.BuffIT.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/golos_text</item>
        <item name="fontFamily">@font/golos_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.BuffIT.Body.Small" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/golos_text</item>
        <item name="fontFamily">@font/golos_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.BuffIT.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/golos_text</item>
        <item name="fontFamily">@font/golos_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.BuffIT.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/golos_text</item>
        <item name="fontFamily">@font/golos_text</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.Yokhan.Navigation" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- BUFF IT Card Style (applied globally via materialCardViewStyle) -->
    <style name="Widget.BuffIT.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/buffit_card_corner_radius</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">@color/buffit_card_border</item>
        <item name="strokeWidth">@dimen/buffit_card_stroke_width</item>
        <item name="cardBackgroundColor">@color/buffit_card_bg</item>
    </style>

    <!-- BUFF IT Shape Overrides -->
    <style name="ShapeAppearance.BuffIT.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeAppearance.BuffIT.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Theme.Start" parent="Theme.MaterialComponents.DayNight">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@android:color/transparent</item>
        <item name="colorPrimaryDark">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

</resources>
